<Project>
  <!--
    ソリューション全体に共通のビルド設定（設計書 第12.7節、指示書 制約11・12）。
    このファイル、Directory.Packages.props、.editorconfig、src/Custos.Analyzers は
    適合テストと同じく、人間の承認なしに変えない。検査を緩める変更は特に禁止。
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- null許容参照型を有効にし、警告はすべてエラーとして扱う -->
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <MSBuildTreatWarningsAsErrors>true</MSBuildTreatWarningsAsErrors>
    <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>

    <!-- コード解析（アナライザー）を有効にし、規則への違反をエラーとして扱う -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- 再現性（指示書 制約10）：ロックファイルで依存の版を固定する -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CUSTOS_LOCKED_RESTORE)' == 'true'">true</RestoreLockedMode>
    <Deterministic>true</Deterministic>

    <!--
      部品のイメージは linux の x64 と arm64 で発行する（ImageBuilder が dotnet publish -r を使う）。両方を宣言しておき、
      packages.lock.json がビルドしたマシンのアーキテクチャで書き換わらないようにする（2026-11-28 利用者が承認）。
      アナライザーにも宣言する（dotnet publish -r の復元は参照先のプロジェクトにも RID を渡すので、宣言がないと最後に発行した RID の節ができる）
    -->
    <RuntimeIdentifiers>linux-x64;linux-arm64</RuntimeIdentifiers>

    <!--
      判定器のハッシュ（FrameworkInfo.JudgeHash。アセンブリの中身から計算する）が、コードが同じなら
      コミットやビルドした場所に関係なく同じになるようにする：版にコミットのハッシュを入れず、ソースのパスを正規化し、
      SourceLink（PDB にリポジトリの URL とコミットを書く）を使わない。PDB のチェックサムが DLL に入るので、
      SourceLink があるとコミットやリモートの URL で DLL が変わる（2026-11-28 利用者が承認。実測で確かめた）
    -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <EnableSourceLink>false</EnableSourceLink>

    <Version>0.1.0</Version>
    <Authors>Custos</Authors>
    <Company>Custos</Company>
    <Product>Custos</Product>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- 禁止構文（dynamic、! 演算子、警告の抑止）を検出する自前のアナライザーを全プロジェクトに付ける -->
  <!-- アナライザーはコンパイラ（ビルドするマシン）の中で動くので、発行先の RID（-r）を引き継がない。
       引き継ぐと、x64 のマシンで arm64 向けに発行したときに、arm64 のアナライザーを読めずに失敗する -->
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'Custos.Analyzers'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)src/Custos.Analyzers/Custos.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all"
                      GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained" />
  </ItemGroup>
</Project>
